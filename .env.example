# Copy to ".env" for local work. On the host, set these in the dashboard instead.
# NEVER commit the real .env (it is listed in .gitignore).

NODE_ENV=development            # set to "production" on the host
# PORT is set automatically by the host; leave it out there.
SESSION_SECRET=change-this-to-a-long-random-string   # use a NEW one in production

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=cspc_app
DB_PASSWORD=
DB_NAME=cspc_feedback
DB_SSL=false                    # true by default when NODE_ENV=production
# DB_SSL_CA=                    # only if your provider gives a CA certificate (paste with \n for line breaks)

# ---- First admin account (only used when the admins table is empty) ----
DEFAULT_ADMIN_EMAIL=your-name@my.cspc.edu.ph
DEFAULT_ADMIN_PASSWORD=         # required in production

# ---- App URLs ----
APP_URL=http://localhost:3000   # your live https:// address in production
PUBLIC_URL=
ADMIN_URL=

# ---- Email (Gmail app password, NOT your normal password) ----
GMAIL_USER=
GMAIL_APP_PASSWORD=
FEEDBACK_RECEIVER=

SUPPORT_PHONE=+63 950 357 7267
SUPPORT_HOURS=Monday to Friday, 8:00 AM – 5:00 PM
SUPPORT_LOCATION=Office of Student Affairs and Services, CSPC Main Campus
SUPPORT_RESPONSE=3 to 5 working days
