  <!DOCTYPE html>
  <html lang="en" class="login-fx-html">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="login-fx-body">
    <div class="login-fx-page">
      <div class="login-fx-bg"></div>

      <div class="login-fx-main">
        <div class="login-fx-leftpane">
          <div class="login-fx-left">
          <img src="/images/cspc-logo.png" alt="CSPC Seal" class="login-fx-logo">
          <h1 class="login-fx-title">
            CSPC
            <span class="accent-gold">FEEDBACK &amp; SUGGESTION SYSTEM</span>
          </h1>
          <p class="login-fx-sub">Your voice helps us build a better Camarines Sur Polytechnic Colleges.</p>

          <div class="login-fx-divider"></div>

          <div class="login-fx-features">
            <div class="login-fx-feature">
              <span class="login-fx-feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              </span>
              <span class="login-fx-feature-label">LISTEN</span>
            </div>
            <div class="login-fx-feature">
              <span class="login-fx-feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg>
              </span>
              <span class="login-fx-feature-label">RESPOND</span>
            </div>
            <div class="login-fx-feature">
              <span class="login-fx-feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
              </span>
              <span class="login-fx-feature-label">IMPROVE</span>
            </div>
          </div>

          <blockquote class="login-fx-quote">
            <span class="quote-mark">&ldquo;</span>Empowering the CSPC community through feedback, suggestions, and continuous improvement.<span class="quote-mark">&rdquo;</span>
          </blockquote>
          </div>
        </div>

        <div class="login-fx-card-wrap">
          <div class="login-fx-card">
            <div class="login-fx-avatar">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h2 class="login-fx-card-title">Administrator Portal</h2>
            <p class="login-fx-card-sub">Sign in to access the system</p>

            <div class="login-fx-card-divider"><span></span><i></i><span></span></div>

            <%- include('../partials/flash') %>

            <form action="/admin/login" method="POST" class="login-fx-form" novalidate>
              <div class="fx-field">
                <label for="username">Username</label>
                <div class="fx-input-wrap">
                  <span class="fx-input-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  </span>
                  <input type="text" id="username" name="username" placeholder="Enter your email address" autocomplete="username" autofocus>
                </div>
                <%- include('../partials/field-error', { field: 'username' }) %>
              </div>

              <div class="fx-field">
                <label for="password">Password</label>
                <div class="fx-input-wrap">
                  <span class="fx-input-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  </span>
                  <input type="password" id="password" name="password" placeholder="Enter your password" autocomplete="current-password">
                  <button type="button" class="fx-eye-toggle" id="togglePassword" aria-label="Show password" aria-pressed="false">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-eye"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-eye-off"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/><path d="m2 2 20 20"/></svg>
                  </button>
                </div>
                <%- include('../partials/field-error', { field: 'password' }) %>
              </div>

              <a href="/admin/forgot-password" class="fx-forgot-link">Forgot password?</a>

              <div class="fx-terms-row">
                <input type="checkbox" name="terms_accepted" id="terms_accepted">
                <label for="terms_accepted">
                  I have read and agree to the
                  <a href="#" id="openTermsModal">Terms &amp; Conditions</a>
                  of this system.
                </label>
              </div>
              <%- include('../partials/field-error', { field: 'terms' }) %>

              <button type="submit" class="fx-btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></svg>
                LOG IN
              </button>
            </form>
          </div>
        </div>

        <svg class="login-fx-wave" viewBox="0 0 1440 120" preserveAspectRatio="none">
          <path d="M0,64 C 240,120 480,0 720,32 C 960,64 1200,120 1440,64 L1440,120 L0,120 Z"></path>
        </svg>
      </div>

      <footer class="login-fx-footer">
        <span>&copy; <%= new Date().getFullYear() %> Camarines Sur Polytechnic Colleges. All rights reserved.</span>
        <span class="login-fx-tagline">&ldquo;Nurturing Minds. Transforming Lives.&rdquo;</span>
      </footer>
    </div>

    <!-- Terms & Conditions modal -->
    <div class="fx-modal-overlay" id="termsModalOverlay">
      <div class="fx-modal">
        <div class="fx-modal-header">
          <h3>Terms &amp; Conditions</h3>
          <button type="button" class="fx-modal-close" id="closeTermsModal" aria-label="Close">&times;</button>
        </div>
        <div class="fx-modal-body">
          <h4>1. Authorized Use</h4>
          <p>This Admin Portal is restricted to authorized personnel of the CSPC Feedback &amp; Suggestion System. Access credentials must not be shared with unauthorized individuals.</p>
          <h4>2. Confidentiality</h4>
          <p>Feedback, complaints, and personal information submitted by users must be handled confidentially and used solely for the purpose of reviewing, responding to, and improving CSPC services.</p>
          <h4>3. Accountability</h4>
          <p>All actions performed under an admin account are logged and attributed to that account. Administrators are responsible for maintaining the security of their login credentials.</p>
          <h4>4. Data Protection</h4>
          <p>Administrators shall comply with the Data Privacy Act of 2012 (RA 10173) and CSPC's data privacy policies when accessing or processing feedback records.</p>
          <h4>5. Acceptable Use</h4>
          <p>Misuse of admin privileges, including unauthorized data disclosure, tampering with records, or accessing the system for purposes unrelated to official duties, is strictly prohibited and may result in access revocation.</p>
          <h4>6. Changes</h4>
          <p>These terms may be updated from time to time. Continued use of the Admin Portal constitutes acceptance of the current terms.</p>
        </div>
        <div class="fx-modal-footer">
          <button type="button" id="acceptTermsModal">I Understand</button>
        </div>
      </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/js/main.js"></script>
  </body>
  </html>
