<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/pub-head') %>
</head>
<body class="pub-page">
<%- include('partials/pub-header', { active: 'contact' }) %>

  <section class="hero hero-compact">
    <div class="wrap hero-inner">
      <span class="hero-chip"><%- icon('headphones', 12) %> We're here to help</span>
      <h1>Contact Us</h1>
      <p>Reach the Office of Student Affairs and Services for questions about your submission or your data.</p>
    </div>
  </section>

  <main class="wrap hp-wrap">
    <div class="hp-col">

      <section class="hp-card">
        <h2>Office of Student Affairs and Services</h2>
        <p class="hp-sub">Camarines Sur Polytechnic Colleges</p>
        <dl class="hp-contact">
          <% if (SUPPORT.email) { %><div><dt>Email</dt><dd><a href="mailto:<%= SUPPORT.email %>"><%= SUPPORT.email %></a></dd></div><% } %>
          <div><dt>Phone</dt><dd><%= SUPPORT.phone %></dd></div>
          <div><dt>Office hours</dt><dd><%= SUPPORT.hours %></dd></div>
          <div><dt>Location</dt><dd><%= SUPPORT.location %></dd></div>
          <div><dt>Response time</dt><dd>We aim to review submissions within <%= SUPPORT.response %>.</dd></div>
        </dl>
      </section>

      <section class="hp-card">
        <h2>What can we help with?</h2>
        <p class="hp-sub">Select a topic to read more.</p>
        <div class="faq">
          <details class="faq-item">
            <summary>How do I check my submission? <%- icon('chevron-down', 18) %></summary>
            <div class="faq-body"><p>Use <a href="/track">Track Status</a> and enter your ticket number.</p></div>
          </details>
          <details class="faq-item">
            <summary>I lost my ticket number. <%- icon('chevron-down', 18) %></summary>
            <div class="faq-body"><p>Visit the office or call us, and bring the subject and approximate date of your submission. Anonymous submissions can only be found with their ticket number.</p></div>
          </details>
          <details class="faq-item">
            <summary>How do I make a data privacy request? <%- icon('chevron-down', 18) %></summary>
            <div class="faq-body"><p>To access, correct, or delete your data, contact the office using the details above. See the <a href="/privacy">Privacy Policy</a> for your rights.</p></div>
          </details>
          <details class="faq-item">
            <summary>Where can I find common answers? <%- icon('chevron-down', 18) %></summary>
            <div class="faq-body"><p>See the <a href="/help">Help Center</a> for frequently asked questions.</p></div>
          </details>
        </div>
      </section>

      <aside class="hp-notice" role="note">
        <span class="hp-notice-icon"><%- icon('alert-triangle', 18) %></span>
        <div>
          <strong>This system is not for emergencies.</strong>
          <p>For urgent or safety concerns, go directly to the Office of Student Affairs and Services or the campus guidance office, or contact your local emergency services.</p>
        </div>
      </aside>

      <div class="hp-links">
        <a href="/" class="btn btn-primary">Submit Feedback <%- icon('arrow-right', 16) %></a>
        <a href="/track" class="btn btn-ghost">Track Status</a>
      </div>

    </div>
  </main>

  <%- include('partials/pub-footer') %>
</body>
</html>
